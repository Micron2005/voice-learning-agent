PORT=3410
APP_URL=http://localhost:3410
VOICE_DATA_DIR=./data
NEXT_TELEMETRY_DISABLED=1
# Only for trusted local stdio clients; copy the ID from MCP connection after setup.
# VOICE_OPERATOR_ID=
# VOICE_MCP_SCOPES=voice:read calls:read calls:prepare calls:stop
# Local first-run account creation is allowed only on a loopback-bound server.
# Remote deployments MUST pre-provision OWNER_EMAIL and OWNER_PASSWORD (16+ chars).
# OWNER_EMAIL=mukarramalam@vultrix.net
# OWNER_PASSWORD=
# Production: HTTPS reverse proxy, encrypted persistent disk, backups, separate worker.
# No paid operations can be enabled in this milestone. No provider credentials needed.
# Optional read-only Twilio account setup; credentials alone never enable calls.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Optional read-only readiness inspection (never sent to a browser):
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_PHONE_NUMBER_ID=
# ELEVENLABS_WEBHOOK_SECRET=
# Bind beyond loopback only behind a private HTTPS gateway:
# HOST=127.0.0.1
